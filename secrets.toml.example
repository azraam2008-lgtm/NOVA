# Streamlit Cloud: App settings > Secrets içine yapıştır.
# Yerelde: .streamlit/secrets.toml olarak kaydet ve .gitignore'a ekle. Bu dosyayı GitHub'a gerçek anahtarla yükleme.
GEMINI_API_KEY = "buraya_anahtar"

# İsteğe bağlı
GEMINI_MODEL = "gemini-2.5-flash-lite"
SUPPORT_URL  = ""   # bağış/destek bağlantın; boşsa buton görünmez
SPONSOR_TEXT = ""   # sponsor yazısı; SPONSOR_URL ile birlikte doldurulursa görünür
SPONSOR_URL  = ""
